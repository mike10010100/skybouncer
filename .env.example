# ==============================================================================
# Skybouncer Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Jev Structured Classification API (System-1 Fast Evaluator)
# ------------------------------------------------------------------------------
# Base URL for the Jev classification API.
# Live endpoints available on nmo.purdlauski.net:
#   - Decision Gateway (System-One fast evaluator, ~250ms): http://nmo.purdlauski.net:8000
#   - Native Ollama service (/api/chat JSON output):       http://nmo.purdlauski.net:11434
#   - Standard mock/hosted Jev API:                        https://nmo.purdlauski.net
JEV_API_BASE_URL=http://nmo.purdlauski.net:8000

# API key for Jev classification service (leave empty for nmo/Ollama instances with no auth)
JEV_API_KEY=

# Classification model identifier:
#   - For System-One (:8000): 'tev1', 'nimble', or 'auto'
#   - For Ollama (:11434):    'tev1:latest', 'nimble:latest', or 'qwen3.8:27b'
#   - For standard Jev:       'jev-system1-mod-v1'
JEV_MODEL=tev1

# Request timeout in milliseconds (default: 15000)
JEV_TIMEOUT_MS=15000

# Maximum retry attempts on transient errors (5xx / network disconnects, default: 1)
# Note: Client errors (4xx) are NEVER retried.
JEV_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 2. Moderation Rubric & Sensitivity
# ------------------------------------------------------------------------------
# Natural-language house rules evaluated by classifiers
SKYBOUNCER_RULES="Block crypto airdrop spam, scam bots, phishing, targeted harassment, and bad-faith sea-lioning."

# Sensitivity threshold: low (threshold >= 0.90), medium (>= 0.75), high (>= 0.60)
SKYBOUNCER_SENSITIVITY=medium

# ------------------------------------------------------------------------------
# 3. Target Ingestion & Jetstream Firehose
# ------------------------------------------------------------------------------
# ATProto Jetstream WebSocket firehose endpoint
SKYBOUNCER_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Comma-separated list of protected user DIDs to monitor and shield
SKYBOUNCER_PROTECTED_DIDS=did:plc:exampleuserdid12345,did:plc:seconduserdid67890

# ------------------------------------------------------------------------------
# 4. Storage & Deduplication Cache
# ------------------------------------------------------------------------------
# SQLite database path for modlist tracking and 24h evaluation deduplication cache
SKYBOUNCER_DATABASE_PATH=skybouncer.db

# Evaluation TTL cache in seconds (default: 86400 = 24 hours)
SKYBOUNCER_EVAL_CACHE_TTL_SECS=86400

# ------------------------------------------------------------------------------
# 5. Sovereign PDS Credentials (for Moderation List Mutations)
# ------------------------------------------------------------------------------
# Sovereign PDS URL where the user's modlist records are stored
PDS_ENDPOINT=https://bsky.social

# PDS Bearer access token for DPoP-signed repository mutations (app.bsky.graph.listitem)
PDS_ACCESS_TOKEN=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 6. ATProto DM Bot Interface (chat.bsky.convo.*)
# ------------------------------------------------------------------------------
# ATProto Chat service endpoint (default: https://api.bsky.chat)
CHAT_ENDPOINT=https://api.bsky.chat

# Bot bearer access token for reading and replying to DMs (defaults to PDS_ACCESS_TOKEN if unset)
CHAT_ACCESS_TOKEN=xxxx-xxxx-xxxx-xxxx

# Decentralized identifier (DID) of the bot account (defaults to first PROTECTED_DIDS entry if unset)
BOT_DID=did:plc:skybouncerbotdid12345

# ------------------------------------------------------------------------------
# 7. Sovereign Web Dashboard & ATProto OAuth 2.0 PKCE
# ------------------------------------------------------------------------------
# Enable embedded web dashboard server (default: false unless PORT is set)
WEB_ENABLED=true

# Host address to bind the web server to (default: 127.0.0.1)
HOST=127.0.0.1

# Port to bind the web server to (default: 3000)
PORT=3000

# Public base URL where the dashboard is reachable (default: http://{HOST}:{PORT})
PUBLIC_URL=http://127.0.0.1:3000

# Optional custom OAuth client ID (defaults to {PUBLIC_URL}/oauth/client-metadata.json)
# OAUTH_CLIENT_ID=https://skybouncer.example.com/oauth/client-metadata.json

# Optional custom OAuth redirect URI (defaults to {PUBLIC_URL}/oauth/callback)
# OAUTH_REDIRECT_URI=https://skybouncer.example.com/oauth/callback

# ------------------------------------------------------------------------------
# 8. Regex Heuristic Pre-Filter (Optional Opt-In)
# ------------------------------------------------------------------------------
# Whether to enable the zero-cost regex heuristic pre-filter.
# Defaults to false to avoid false-positive classifications on homonyms and benign speech
# (e.g. Apple AirDrop, military airdrops, connect-wallet warnings).
# When set to true, obvious spam patterns are short-circuited before calling the model API.
# ENABLE_HEURISTIC_PREFILTER=false

# ------------------------------------------------------------------------------
# 9. Shadow Mode / Dry-Run (Risk-Free Firehose Streaming)
# ------------------------------------------------------------------------------
# When enabled, skybouncer connects to the live Jetstream firehose, evaluates
# incoming interactions targeting protected users with the live AI model,
# but simulates all PDS listitem mutations locally with ZERO remote network writes.
# Can also be passed via CLI: `cargo run -- --dry-run` or `--shadow-mode`
# DRY_RUN=true

# ------------------------------------------------------------------------------
# 10. Tiered Multimodal Architecture & Vision Fallback (System-2)
# ------------------------------------------------------------------------------
# Optional secondary/fallback model for multimodal inspection or complex reasoning
# (e.g., when ambiguous text confidence is detected, or image attachments are present).
#
# Option A - Decision Gateway (Port 8000, fast sub-second calibrated decision):
# FALLBACK_API_BASE_URL=http://nmo.purdlauski.net:8000
# FALLBACK_MODEL=nimble
# (or 'clef-flash' for multimodal fast decision)
#
# Option B - Native Ollama Service (Port 11434, direct multimodal chat):
# FALLBACK_API_BASE_URL=http://nmo.purdlauski.net:11434
# FALLBACK_MODEL=gemma4:12b
# (or 'qwen3.8:27b' / 'llama3.2-vision')
#
# FALLBACK_API_KEY=

# Uncertainty boundary band [min, max): scores falling strictly within this range
# trigger escalation to the fallback model. Decisive violations (>= max) short-circuit immediately.
# UNCERTAINTY_MIN=0.40
# UNCERTAINTY_MAX=0.85

# Whether interactions with attached visual images escalate to the multimodal fallback model (default: true)
# ESCALATE_ON_IMAGES=true


