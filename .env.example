# ==============================================================================
# Skybouncer Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Jev Structured Classification API (System-1 Fast Evaluator)
# ------------------------------------------------------------------------------
# Base URL for the Jev classification API (default: https://nmo.purdlauski.net)
JEV_API_BASE_URL=https://nmo.purdlauski.net

# API key for Jev classification service
JEV_API_KEY=sk_jev_live_placeholder_12345

# Jev classification model identifier (default: jev-system1-mod-v1)
JEV_MODEL=jev-system1-mod-v1

# Request timeout in milliseconds (default: 3000)
JEV_TIMEOUT_MS=3000

# Maximum retry attempts on transient errors (5xx / network disconnects, default: 1)
# Note: Client errors (4xx) are NEVER retried.
JEV_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 2. Moderation Rubric & Sensitivity
# ------------------------------------------------------------------------------
# Natural-language house rules evaluated by classifiers
SKYBOUNCER_RULES="Block crypto airdrop spam, scam bots, phishing, targeted harassment, and bad-faith sea-lioning."

# Sensitivity threshold: low (threshold >= 0.90), medium (>= 0.75), high (>= 0.60)
SKYBOUNCER_SENSITIVITY=medium

# ------------------------------------------------------------------------------
# 3. Target Ingestion & Jetstream Firehose
# ------------------------------------------------------------------------------
# ATProto Jetstream WebSocket firehose endpoint
SKYBOUNCER_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Comma-separated list of protected user DIDs to monitor and shield
SKYBOUNCER_PROTECTED_DIDS=did:plc:exampleuserdid12345,did:plc:seconduserdid67890

# ------------------------------------------------------------------------------
# 4. Storage & Deduplication Cache
# ------------------------------------------------------------------------------
# SQLite database path for modlist tracking and 24h evaluation deduplication cache
SKYBOUNCER_DATABASE_PATH=skybouncer.db

# Evaluation TTL cache in seconds (default: 86400 = 24 hours)
SKYBOUNCER_EVAL_CACHE_TTL_SECS=86400

# ------------------------------------------------------------------------------
# 5. Sovereign PDS Credentials (for Moderation List Mutations)
# ------------------------------------------------------------------------------
# Sovereign PDS URL where the user's modlist records are stored
PDS_ENDPOINT=https://bsky.social

# PDS Bearer access token for DPoP-signed repository mutations (app.bsky.graph.listitem)
PDS_ACCESS_TOKEN=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 6. ATProto DM Bot Interface (chat.bsky.convo.*)
# ------------------------------------------------------------------------------
# ATProto Chat service endpoint (default: https://api.bsky.chat)
CHAT_ENDPOINT=https://api.bsky.chat

# Bot bearer access token for reading and replying to DMs (defaults to PDS_ACCESS_TOKEN if unset)
CHAT_ACCESS_TOKEN=xxxx-xxxx-xxxx-xxxx

# Decentralized identifier (DID) of the bot account (defaults to first PROTECTED_DIDS entry if unset)
BOT_DID=did:plc:skybouncerbotdid12345

# ------------------------------------------------------------------------------
# 7. Sovereign Web Dashboard & ATProto OAuth 2.0 PKCE
# ------------------------------------------------------------------------------
# Enable embedded web dashboard server (default: false unless PORT is set)
WEB_ENABLED=true

# Host address to bind the web server to (default: 127.0.0.1)
HOST=127.0.0.1

# Port to bind the web server to (default: 3000)
PORT=3000

# Public base URL where the dashboard is reachable (default: http://{HOST}:{PORT})
PUBLIC_URL=http://127.0.0.1:3000

# Optional custom OAuth client ID (defaults to {PUBLIC_URL}/oauth/client-metadata.json)
# OAUTH_CLIENT_ID=https://skybouncer.example.com/oauth/client-metadata.json

# Optional custom OAuth redirect URI (defaults to {PUBLIC_URL}/oauth/callback)
# OAUTH_REDIRECT_URI=https://skybouncer.example.com/oauth/callback

