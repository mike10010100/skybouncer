# ==============================================================================
# Caddy Reverse Proxy Configuration for Skybouncer
# Automatic HTTPS via Let's Encrypt / ZeroSSL
# ==============================================================================

moderation.example.com {
    # Reverse proxy to local Skybouncer Web Dashboard & OAuth API
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Essential HTTP Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Structured JSON Access Logging
    log {
        output file /var/log/caddy/skybouncer_access.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }
}
