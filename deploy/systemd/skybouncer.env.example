# ==============================================================================
# Skybouncer Production Environment Configuration Template
# Place in: /etc/skybouncer/skybouncer.env (chmod 0600, root:skybouncer)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Protected Users, Admin & Jetstream
# ------------------------------------------------------------------------------
# Optional Fleet Administrator DID (granted fleet oversight & automatically shielded)
ADMIN_DID=did:plc:youradmindidhere

# Comma-separated list of static protected ATProto DIDs shielded on startup
SKYBOUNCER_PROTECTED_DIDS=did:plc:yourprotecteduserdidhere

# Sovereign PDS URL fallback
PDS_ENDPOINT=https://bsky.social

# ATProto Jetstream WebSocket firehose endpoint
SKYBOUNCER_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# ------------------------------------------------------------------------------
# 2. Moderation Rubric & Sensitivity
# ------------------------------------------------------------------------------
# Natural-language moderation instructions evaluated by the classifier
SKYBOUNCER_RULES="Block crypto scam bots, wallet drainers, phishing links, aggressive harassment, and bad-faith sea-lioning."

# Operating sensitivity threshold: low (>=0.90), medium (>=0.75), high (>=0.60)
SKYBOUNCER_SENSITIVITY=medium

# ------------------------------------------------------------------------------
# 3. Primary Decision Gateway / Jev Classifier
# ------------------------------------------------------------------------------
# URL of the primary Jev-like structured classification API (TypeSafe AI / SystemOne / Ollama)
JEV_API_BASE_URL=http://127.0.0.1:8000
JEV_API_KEY=
JEV_MODEL=nimble
JEV_TIMEOUT_MS=15000
JEV_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 4. Multimodal Vision Fallback Classifier (Optional Tier 2)
# ------------------------------------------------------------------------------
# Triggered when primary model confidence falls within uncertainty band [0.40, 0.85)
FALLBACK_API_BASE_URL=http://127.0.0.1:11434
FALLBACK_API_KEY=
FALLBACK_MODEL=gemma4:26b
FALLBACK_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=16384
ESCALATE_ON_IMAGES=true
UNCERTAINTY_MIN=0.40
UNCERTAINTY_MAX=0.85

# ------------------------------------------------------------------------------
# 5. ATProto DM Bot Interface (Optional)
# ------------------------------------------------------------------------------
# Recommended: App Password login (automatically resolves BOT_DID and refreshes tokens)
BOT_HANDLE=
BOT_APP_PASSWORD=
# Optional manual chat token override (alternative to BOT_HANDLE + BOT_APP_PASSWORD)
# CHAT_ACCESS_TOKEN=
# BOT_DID=
CHAT_POLL_INTERVAL_SECS=3

# ------------------------------------------------------------------------------
# 6. Sovereign Web Dashboard, OAuth & Proxy Security
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
WEB_ENABLED=true
PUBLIC_URL=https://moderation.example.com
# OAUTH_CLIENT_ID=https://moderation.example.com/oauth/client-metadata.json
# OAUTH_REDIRECT_URI=https://moderation.example.com/oauth/callback

# Operator API / Prometheus bearer tokens (optional, min 8 chars)
# SKYBOUNCER_API_TOKEN=
# SKYBOUNCER_METRICS_TOKEN=
# SKYBOUNCER_METRICS_PUBLIC=false

# Reverse-Proxy Real-IP Extraction (honor forwarded header ONLY from trusted proxy CIDRs)
# TRUSTED_PROXY_HEADER=x-forwarded-for
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ------------------------------------------------------------------------------
# 7. Persistence, Encryption & Caching
# ------------------------------------------------------------------------------
SKYBOUNCER_DATABASE_PATH=/var/lib/skybouncer/skybouncer.db
# 64-character hex key encrypting OAuth sessions & client keys in SQLite.
# Auto-generated during install.sh (or at <db_dir>/.skybouncer.key if unset).
SKYBOUNCER_SESSION_ENCRYPTION_KEY=
SKYBOUNCER_EVAL_CACHE_TTL_SECS=86400
LIST_NAME="Skybouncer Moderation List"
LIST_DESCRIPTION="Automated sovereign moderation list maintained by Skybouncer."

# ------------------------------------------------------------------------------
# 8. Safeguards & Observability
# ------------------------------------------------------------------------------
# Maximum model evaluations per user DID per hour
SKYBOUNCER_RATE_LIMIT_EVALS_PER_HOUR=100
# Zero-cost regex pre-filter (default: false to eliminate regex false positives)
ENABLE_HEURISTIC_PREFILTER=false
# Dry-run shadow mode: stream firehose and run models without mutating PDS lists
DRY_RUN=false
# Structured logging filter
RUST_LOG=info,skybouncer=info,skybase=info
