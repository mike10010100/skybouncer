# ==============================================================================
# Skybouncer Production Environment Configuration Template
# Place in: /etc/skybouncer/skybouncer.env (chmod 0600)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Protected Users & PDS Identity (Required)
# ------------------------------------------------------------------------------
# Comma-separated list of protected ATProto DIDs shielded by this instance
PROTECTED_DIDS=did:plc:yourprotecteduserdidhere

# Sovereign PDS Credentials for moderation list mutations
PDS_URL=https://bsky.social
PDS_USERNAME=yourhandle.bsky.social
PDS_PASSWORD=your-app-password-here

# ------------------------------------------------------------------------------
# 2. Moderation Rubric & Sensitivity
# ------------------------------------------------------------------------------
# Natural-language moderation instructions evaluated by the classifier
MODERATION_RULES="Block crypto scam bots, wallet drainers, phishing links, aggressive harassment, and bad-faith sea-lioning."

# Operating sensitivity threshold: low (>=0.90), medium (>=0.75), high (>=0.60)
SENSITIVITY=medium

# ------------------------------------------------------------------------------
# 3. Primary Decision Gateway / Jev Classifier
# ------------------------------------------------------------------------------
# URL of the primary Jev-like structured classification API (TypeSafe AI / SystemOne / Ollama)
JEV_API_BASE_URL=https://api.jev.ai
JEV_API_KEY=
JEV_MODEL=nimble
JEV_TIMEOUT_MS=15000
JEV_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. Multimodal Vision Fallback Classifier (Optional Tier 2)
# ------------------------------------------------------------------------------
# Triggered when primary model confidence falls within uncertainty band [0.40, 0.85)
FALLBACK_JEV_API_BASE_URL=http://127.0.0.1:11434/api/chat
FALLBACK_JEV_API_KEY=
FALLBACK_JEV_MODEL=gemma4:12b
CERTAINTY_MIN=0.40
CERTAINTY_MAX=0.85

# ------------------------------------------------------------------------------
# 5. ATProto DM Bot Interface (Optional Mode 1)
# ------------------------------------------------------------------------------
# Configures conversational direct-message moderation bot on chat.bsky.convo
BOT_DID=
CHAT_ACCESS_TOKEN=
CHAT_POLL_INTERVAL_SECS=3

# ------------------------------------------------------------------------------
# 6. Sovereign Web Dashboard & OAuth (Mode 2)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
WEB_ENABLED=true
PUBLIC_URL=https://moderation.example.com
CLIENT_ID=https://moderation.example.com/oauth/client-metadata.json
REDIRECT_URI=https://moderation.example.com/oauth/callback

# ------------------------------------------------------------------------------
# 7. Persistence & Caching
# ------------------------------------------------------------------------------
SKYBOUNCER_DATABASE_PATH=/var/lib/skybouncer/skybouncer.db
EVALUATION_CACHE_TTL_HOURS=24
LIST_NAME="Skybouncer Auto-Filter"
LIST_DESCRIPTION="Automated moderation list managed by Skybouncer"

# ------------------------------------------------------------------------------
# 8. Safeguards & Observability
# ------------------------------------------------------------------------------
# Maximum model evaluations per user DID per hour
RATE_LIMIT_PER_HOUR=100
# Zero-cost regex pre-filter (default: false to eliminate regex false positives)
ENABLE_HEURISTIC_PREFILTER=false
# Dry-run shadow mode: stream firehose and run models without mutating PDS lists
DRY_RUN=false
# Structured logging filter
RUST_LOG=info,skybouncer=info,skybase=info
