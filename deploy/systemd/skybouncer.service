[Unit]
Description=Skybouncer Sovereign Auto-Moderation & Bouncer Service for ATProto
Documentation=https://github.com/mike10010100/skybouncer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skybouncer
Group=skybouncer
WorkingDirectory=/var/lib/skybouncer
ExecStart=/usr/local/bin/skybouncer
Restart=always
RestartSec=5s
TimeoutStopSec=30s

# Environment configuration (strictly required)
EnvironmentFile=/etc/skybouncer/skybouncer.env
Environment=SKYBOUNCER_DATABASE_PATH=/var/lib/skybouncer/skybouncer.db
Environment=HOST=127.0.0.1
Environment=PORT=3000

# File descriptor ceiling for high-concurrency Jetstream WebSocket streaming
LimitNOFILE=65536

# Security & Sandbox Hardening
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
LockPersonality=true
MemoryMax=2G
TasksMax=256
ReadWritePaths=/var/lib/skybouncer

[Install]
WantedBy=multi-user.target
